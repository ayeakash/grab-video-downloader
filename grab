#!/usr/bin/env bash
# Wrapper so you can run ./grab from anywhere without activating the venv.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$HERE/.venv/bin/python"

if [[ ! -x "$PY" ]]; then
  echo "Virtualenv missing. Run: $HERE/setup.sh" >&2
  exit 1
fi

exec "$PY" -m grabber "$@"
